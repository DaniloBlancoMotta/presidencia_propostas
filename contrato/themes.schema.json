{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comparador.local/contrato/themes.schema.json",
  "title": "themes.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["temas"],
  "properties": {
    "temas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rotulo", "icone", "descricao", "palavras_chave", "macrotema_tse"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "rotulo": { "type": "string", "minLength": 1 },
          "icone": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "descricao": { "type": "string", "minLength": 1 },
          "palavras_chave": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
          "macrotema_tse": { "type": ["string", "null"] }
        }
      }
    }
  }
}
